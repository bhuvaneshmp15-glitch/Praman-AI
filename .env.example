# Praman Financial Copilot - Environment Configuration
# ZERO API KEYS REQUIRED: Praman runs 100% out-of-the-box using:
# 1. Local Deterministic Intent & PII Parser (Zero external leaks)
# 2. In-Memory DuckDB Analytical Plane (10,040 rows)
# 3. 4 Live Keyless Public APIs (Razorpay IFSC, India Post, Frankfurter FX, XposedOrNot)
# 4. Deterministic Exact Rupee Runway Calculator

# API Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Plane (DuckDB)
DUCKDB_PATH=praman-data/praman.duckdb
RAW_CSVS_DIR=praman-data/raw_csvs

# OPTIONAL: Keyed LLM Planning (OpenAI or Gemini)
# If provided, prompts are dispatched with automatic PII tokenization (<UTR_TOKEN>, <VPA_TOKEN>, <ACCOUNT_TOKEN>).
# If omitted (default), Praman executes local deterministic entity parsing & SQL generation.
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...

# Frontend CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
