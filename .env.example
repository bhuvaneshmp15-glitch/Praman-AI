# Praman Environment Variables

# API Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Plane (DuckDB)
DUCKDB_PATH=praman-data/praman.duckdb
RAW_CSVS_DIR=praman-data/raw_csvs

# LLM / Reasoning Engine
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Adapters & External Gateways
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_IFSC_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
